<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationIcon>F15Key.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish -c Release: one exe in dist\ (needs the .NET 10 Desktop Runtime). Builds stay in bin\Release\net10.0-windows. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>$(MSBuildProjectDirectory)\dist\</PublishDir>
  </PropertyGroup>

  <!-- Version resource: Company is shown as the Publisher in Task Manager > Startup apps. -->
  <PropertyGroup>
    <Company>N2K02</Company>
    <Authors>N2K02</Authors>
    <Product>F15Key</Product>
    <AssemblyTitle>F15Key</AssemblyTitle>
    <Description>Keeps Teams from going Away by pressing F15 when the PC is idle.</Description>
    <Copyright>Copyright © N2K02 2026</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
